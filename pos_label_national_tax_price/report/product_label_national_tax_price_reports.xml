<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Single continuous PORTRAIT page (72mm wide, tall enough for however
         many labels are being printed) instead of one page per label: this
         printer's driver mishandles a PDF with several small pages, but
         handles one bigger page fine (see models/ir_actions_report.py for
         the per-print-job page height calculation). -->
    <record id="paperformat_comandera_label" model="report.paperformat">
        <field name="name">Comandera Label Sheet (7.2cm wide)</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_width">72</field>
        <field name="page_height">3000</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <record id="report_product_template_label_comandera" model="ir.actions.report">
        <field name="name">Label for comandera with price (7.2cm wide)</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_label_national_tax_price.comandera_label</field>
        <field name="report_file">pos_label_national_tax_price.comandera_label</field>
        <field name="paperformat_id" ref="pos_label_national_tax_price.paperformat_comandera_label"/>
        <field name="print_report_name">'Products Labels - %s' % (object.name)</field>
        <field name="binding_type">report</field>
    </record>

</odoo>
