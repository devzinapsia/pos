<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="comandera_label">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-call="pos_label_national_tax_price.report_productlabel_comandera"/>
            </div>
        </t>
    </template>

    <template id="report_productlabel_comandera">
        <!-- No nested t-call="web.html_container" here: comandera_label
             above already wraps this via web.basic_layout. Core Dymo's own
             template nests it a second time (harmless there, since Dymo's
             hardcoded 57mm width never tries to reach the true page edge);
             for us it's redundant and was making wkhtmltopdf's old WebKit
             render a second, nested <html><body> that didn't collapse
             cleanly. -->
        <t>
            <!-- The report body carries Bootstrap's "container" class AND
                 Odoo's own "o_body_html" class (11mm side padding, meant for
                 real A4 print margins - see web/.../report.scss), plus
                 .o_label_sheet forces "page-break-before: always" (meant for
                 Dymo, where each label really is its own physical sticker).
                 None of that applies to a single continuous roll page. -->
            <style>
                .o_label_sheet { page-break-before: auto !important; }
                body.container, body.o_body_html { padding-left: 0 !important; padding-right: 0 !important; max-width: none !important; margin: 0 !important; }
            </style>
            <t t-set="table_style" t-value="'width:100%;height:40mm;'"/>
            <t t-set="padding_page" t-value="'padding: 2mm; margin-bottom: 4mm;'"/>
            <t t-foreach="quantity.items()" t-as="barcode_and_qty_by_product">
                <t t-set="product" t-value="barcode_and_qty_by_product[0]"/>
                <t t-foreach="barcode_and_qty_by_product[1]" t-as="barcode_and_qty">
                    <t t-foreach="range(barcode_and_qty[1])" t-as="qty">
                        <t t-call="pos_label_national_tax_price.report_simple_label_comandera"/>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="report_simple_label_comandera">
        <t t-set="label_currency" t-value="pricelist.currency_id or product.currency_id"/>
        <t t-set="final_price" t-value="pricelist._get_product_price(product, 1, currency=label_currency)"/>
        <t t-set="price_without_national_taxes" t-value="get_price_without_national_taxes(product, final_price)"/>
        <!-- Explicit width/height/margin override product/report_label_sheet.scss's
             hardcoded .o_label_dymo (57x32mm) / .o_label_sheet (210x297mm,
             margin-left/right: -4mm) sizes, which would otherwise silently
             cap this label narrower than the page, shift it left, and push
             right-aligned content off-page. -->
        <div class="o_label_sheet o_label_dymo" t-att-style="'width:100%;height:40mm;margin:0;' + padding_page">
            <div class="o_label_full" t-att-style="table_style">
                <!-- No barcode: the client's real label doesn't carry one,
                     and the freed vertical space goes to a bigger product
                     name instead.

                     Vertically centered via a real table + vertical-align:
                     middle on its single cell, not flexbox - wkhtmltopdf's
                     old WebKit doesn't render flex reliably (silently kept
                     everything top-aligned, then overlapping once a
                     2-line product name was involved). Table/td valign is
                     the same technique already used elsewhere in Odoo core
                     for this engine (see product_packaging.xml). -->
                <table style="width:100%;height:100%;border-collapse:collapse;">
                    <tr><td style="vertical-align:middle;padding:0;">
                        <div class="o_label_name" style="line-height: 110%;background-color: transparent;font-size: 1.3em;">
                            <span t-if="product.is_product_variant" t-field="product.display_name"/>
                            <span t-else="" t-field="product.name"/>
                        </div>
                        <div class="text-start" style="font-size: 0.7em;padding-top: 1px;">
                            <span t-out="national_tax_price_label"/>
                            <span t-out="price_without_national_taxes" style="margin-left: 2px;"
                                  t-options="{'widget': 'monetary', 'display_currency': label_currency}"/>
                        </div>
                        <div class="text-end" style="padding: 0 4px;">
                            <strong class="o_label_price" t-out="final_price"
                                    t-options="{'widget': 'monetary', 'display_currency': label_currency, 'label_price': True}"/>
                        </div>
                    </td></tr>
                </table>
            </div>
        </div>
    </template>

</odoo>
