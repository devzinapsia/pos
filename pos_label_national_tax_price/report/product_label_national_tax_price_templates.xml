<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="national_tax_price_label">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-call="pos_label_national_tax_price.report_productlabel_national_tax_price"/>
            </div>
        </t>
    </template>

    <template id="report_productlabel_national_tax_price">
        <t t-call="web.html_container">
            <t t-set="barcode_size" t-value="'width:54mm;height:9mm'"/>
            <t t-set="table_style" t-value="'width:100%;height:40mm;'"/>
            <t t-set="padding_page" t-value="'padding: 2mm'"/>
            <t t-foreach="quantity.items()" t-as="barcode_and_qty_by_product">
                <t t-set="product" t-value="barcode_and_qty_by_product[0]"/>
                <t t-foreach="barcode_and_qty_by_product[1]" t-as="barcode_and_qty">
                    <t t-set="barcode" t-value="barcode_and_qty[0]"/>
                    <t t-foreach="range(barcode_and_qty[1])" t-as="qty">
                        <t t-call="pos_label_national_tax_price.report_simple_label_national_tax_price"/>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="report_simple_label_national_tax_price">
        <t t-set="label_currency" t-value="pricelist.currency_id or product.currency_id"/>
        <t t-set="final_price" t-value="pricelist._get_product_price(product, 1, currency=label_currency)"/>
        <t t-set="price_without_national_taxes" t-value="get_price_without_national_taxes(product, final_price)"/>
        <div class="o_label_sheet o_label_dymo" t-att-style="padding_page">
            <div class="o_label_full" t-att-style="table_style">
                <div class="o_label_name" style="line-height: 100%;background-color: transparent;">
                    <span t-if="product.is_product_variant" t-field="product.display_name"/>
                    <span t-else="" t-field="product.name"/>
                </div>
                <div class="text-start" style="font-size: 0.7em;padding-top: 1px;">
                    <span t-out="national_tax_price_label"/>
                    <span t-out="price_without_national_taxes" style="margin-left: 2px;"
                          t-options="{'widget': 'monetary', 'display_currency': label_currency}"/>
                </div>
                <div class="text-end" style="padding: 0 4px;">
                    <strong class="o_label_price" t-out="final_price"
                            t-options="{'widget': 'monetary', 'display_currency': label_currency, 'label_price': True}"/>
                </div>
                <div class="o_label_left_column">
                    <t t-if="barcode">
                        <!-- `quiet=0` to remove the left and right margins on the barcode -->
                        <div t-out="barcode" style="padding:0"
                             t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': barcode_size}"/>
                        <div class="o_label_name" style="height:1.7em;background-color: transparent;">
                            <span t-out="barcode"/>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </template>

</odoo>
